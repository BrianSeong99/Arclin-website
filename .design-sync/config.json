{
  "pkg": "arclin-website",
  "globalName": "Arclin",
  "shape": "storybook",
  "storybookConfigDir": ".storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "buildCmd": "pnpm build:ds",
